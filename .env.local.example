# Server-only and browser-exposed Supabase project credentials.
# NEXT_PUBLIC_* vars are safe to expose — Row Level Security (see
# supabase/schema.sql) is what actually protects the data, not secrecy of
# these values. Project Settings → API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
